 2 files changed, 26 insertions(+), 15 deletions(-)

diff --git a/server/db.ts b/server/db.ts
index 1b4c5d3..7f28f4d 100644
--- a/server/db.ts
+++ b/server/db.ts
@@ -155,6 +155,18 @@ export async function withRetry<T>(fn: () => Promise<T>, retries = 2): Promise<T
   throw lastErr;
 }
 
+/**
+ * Executa uma query SQL raw usando o pool pg diretamente (sem Drizzle).
+ * Usar quando o Drizzle parametriza automaticamente e o driver rejeita $1.
+ * Interpolação deve ser feita pelo caller com escape adequado.
+ */
+export async function rawQuery(sql: string): Promise<any[]> {
+  if (!_pool) await getDb();
+  if (!_pool) throw new Error("Database not available");
+  const result = await _pool.query(sql);
+  return result.rows;
+}
+
 /**
  * Executa uma função com o banco de dados.
  * O isolamento multi-tenant é feito via WHERE tenantId nas queries (guard clauses).
diff --git a/server/routers.ts b/server/routers.ts
index 0381877..2c56502 100644
--- a/server/routers.ts
+++ b/server/routers.ts
@@ -2032,27 +2032,26 @@ export const appRouter = router({
         const existingBarber = await db.getBarberByEmail(input.admin.email);
         if (existingBarber) throw new Error("Este email já está cadastrado");
 
-        // 1b. Verificar se este email ou CPF/CNPJ já usou o trial gratuito
