+<!-- JS do toggle e timer -->
+<script>
+(function(){
+  var ann=false;
+  var P={s:[49.90,478.80],e:[99.90,958.80],t:[169.90,1630.80]};
+  var dl=new Date();dl.setDate(dl.getDate()+30);
+  function fmt(n){return'R$'+n.toFixed(2).replace('.',',');}
+  window.bpToggle=function(){
+    ann=!ann;
+    var sw=document.getElementById('bp-sw');
+    var knob=document.getElementById('bp-knob');
+    sw.setAttribute('aria-checked',ann);
+    if(ann){sw.style.background='rgba(201,168,76,0.12)';sw.style.borderColor='rgba(201,168,76,0.5)';knob.style.transform='translateX(24px)';knob.style.background='#C9A84C';}
+    else{sw.style.background='#1A1A1A';sw.style.borderColor='#2A2A2A';knob.style.transform='translateX(0)';knob.style.background='#3A3A3A';}
+    document.getElementById('bp-lm').style.color=ann?'#666':'#F0EEE8';
+    document.getElementById('bp-lm').style.fontWeight=ann?'400':'600';
+    document.getElementById('bp-la').style.color=ann?'#F0EEE8':'#666';
+    document.getElementById('bp-la').style.fontWeight=ann?'600':'400';
+    document.getElementById('bp-badge').style.display=ann?'inline-flex':'none';
+    updatePrices();
+  };
+  function updatePrices(){
+    var pairs=[['bp-so','bp-sp','bp-sa',P.s],['bp-eo','bp-ep','bp-ea',P.e],['bp-to','bp-tp','bp-ta',P.t]];
+    pairs.forEach(function(x){
+      var oldEl=document.getElementById(x[0]);
+      var prEl=document.getElementById(x[1]);
+      var anEl=document.getElementById(x[2]);
+      var p=x[3];
+      if(ann){
+        var mo=p[1]/12;
+        oldEl.style.display='inline';
+        oldEl.textContent=fmt(p[0]);
+        prEl.textContent=fmt(mo);
+        var saved=Math.round(p[0]*12-p[1]);
+        anEl.textContent=fmt(p[1])+'/ano — economize R$'+saved;
+      }else{
+        oldEl.style.display='none';
+        prEl.textContent=fmt(p[0]);
+        anEl.textContent='';
+      }
+    });
+  }
+  function tick(){
+    var diff=Math.max(0,dl-new Date());
