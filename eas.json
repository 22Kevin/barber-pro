{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "398675034994-8do72mahbndf5olf7rt4njteprr4vh0i.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://usebarberpro.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "398675034994-8do72mahbndf5olf7rt4njteprr4vh0i.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://usebarberpro.com",
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "398675034994-8do72mahbndf5olf7rt4njteprr4vh0i.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
