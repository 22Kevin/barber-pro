+        />
+        <Tabs.Screen
+          name="agenda"
+          options={{
+            title: "Agenda",
+            tabBarIcon: ({ color }) => <IconSymbol name="calendar" size={24} color={color} />,
+          }}
+        />
+        <Tabs.Screen
+          name="clients"
+          options={{
+            title: "Clientes",
