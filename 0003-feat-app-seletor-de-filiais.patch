+        {/* ── Abas secundárias — acessíveis via drawer, ocultas do rodapé ── */}
+        <Tabs.Screen name="services" options={{ title: "Serviços", tabBarItemStyle: { display: "none" } }} />
+        <Tabs.Screen name="products" options={{ title: "Produtos", tabBarItemStyle: { display: "none" } }} />
